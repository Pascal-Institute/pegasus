{
  "name": "pegasus",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "dependencies": {
    "fs": "^0.0.1-security",
    "imgkit": "file:imgkit",
    "sharp": "^0.29.3"
  },
  "devDependencies": {
    "electron": "^16.2.8",
    "electron-rebuild": "^3.2.9",
    "electron-reload": "^2.0.0-alpha.1",
    "electron-builder": "^24.13.3"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "rebuild": "electron-rebuild -f -w sharp"
  },
  "build": {
    "appId": "com.pascal.institute.pegasus",
    "productName": "Pegasus",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "files": [
      "**/*",
      "!dist",
      "!node_modules"
    ],
    "directories": {
      "output": "dist"
    }
  },
  "author": "volta2030",
  "license": "MIT"
}
