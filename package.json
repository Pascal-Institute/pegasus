{
  "name": "pegasus",
  "version": "1.0.3",
  "description": "",
  "main": "main.js",
  "dependencies": {
    "fs": "^0.0.1-security",
    "imgkit": "file:imgkit",
    "sharp": "^0.34.3",
    "sharp-bmp": "^0.1.5",
    "sharp-ico": "^0.1.5"
  },
  "devDependencies": {
    "electron": "^37.3.0",
    "electron-builder": "^26.0.12",
    "electron-rebuild": "^3.2.9",
    "electron-reload": "^2.0.0-alpha.1"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "rebuild": "electron-rebuild -f -w sharp"
  },
  "build": {
    "appId": "com.pascal.institute.pegasus",
    "productName": "pegasus",
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": []
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "**/*",
      "!output"
    ],
    "directories": {
      "output": "output"
    },
    "extraResources": [
      {
        "from": "assets/",
        "to": "../assets/",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "author": "Pascal Institute",
  "license": "MIT"
}
